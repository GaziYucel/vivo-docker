IMAGE_NAME=username/vivo-main
DOCKERFILE=Dockerfile
APP_ENV=production
BUILD_CONTEXT=.

# Tomcat webapp context path
TOMCAT_CONTEXT_PATH=ROOT

# VIVO home directory in container
VIVO_HOME=/usr/local/vivo/home

# TDB file mode
TDB_FILE_MODE=direct

# Root user email address
ROOT_USER_ADDRESS=vivo_root@mydomain.edu

# Default namespace
DEFAULT_NAMESPACE=http://vivo.mydomain.edu/individual/

# VIVO Solr URL
SOLR_URL=http://localhost:8983/solr/vivocore

# VIVO Solr/ElasticSearch/OpenSearch URL / username / password
SEARCH_ENGINE_URL=http://localhost:8983/solr/vivocore
SEARCH_ENGINE_USERNAME=
SEARCH_ENGINE_PASSWORD=

# Individual property associated with user account
SELF_ID_MATCHING_PROPERTY=http://vivo.mydomain.edu/ns#networkId

# Email SMTP host / server port / username / password / reply to
EMAIL_SMTP_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_REPLY_TO=

# Enable language filter to respect browser Accept-Language header
LANGUAGE_FILTER_ENABLED=

# Ignore browser Accept-Language header
FORCE_LOCALE=

# Selectable locales
SELECTABLE_LOCALES=en_US

# Reset VIVO Solr core
RESET_CORE=FALSE

# Reset VIVO home directory
RESET_HOME=FALSE

# Load sample data
LOAD_SAMPLE_DATA=FALSE

# Sample data GitHub repository
SAMPLE_DATA_REPO_URL=https://github.com/vivo-project/sample-data.git

# Sample data GitHub repository branch
SAMPLE_DATA_BRANCH=main

# Sample data directory
SAMPLE_DATA_DIRECTORY=openvivo

# Whether to update runtime properties and application setup
RECONFIGURE=FALSE

